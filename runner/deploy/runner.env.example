# Configuración del AgentForge Runner (~/.config/agentforge-runner/runner.env, modo 0600).
# Genera cada token y su hash con: agentforge-runner token
RUNNER_RUNNER_ID=agentforge-runner-01
RUNNER_TOKEN_SHA256=<sha256 hex del token de la API; el token solo vive en la API>
# Credencial separada para operadores (inspeccionar/reconciliar/resolver ejecuciones inciertas).
RUNNER_ADMIN_TOKEN_SHA256=<sha256 hex del token de administración; opcional>
# Escuchar solo en una dirección privada: IP de Tailscale, loopback o la IP privada de la VM/VPC. Nunca 0.0.0.0.
RUNNER_BIND_HOST=100.x.y.z
RUNNER_PORT=8787
RUNNER_STATE_DIR=/home/agentforge-runner/.local/share/agentforge-runner
# Imágenes por perfil, fijadas por digest (podman image inspect --format '{{.Digest}}').
RUNNER_IMAGES={"python-3.13":"localhost/agentforge/python-3.13@sha256:<digest>"}
RUNNER_MAX_CONCURRENT=2
RUNNER_MAX_WALL_SECONDS=900
RUNNER_MAX_MEMORY_BYTES=4294967296
RUNNER_MAX_STORAGE_BYTES=2147483648
# Orígenes aceptados además del token: tailnet; en una VPC, su CIDR; en una VM local, la IP del host de la API.
RUNNER_ALLOWED_CLIENT_CIDRS=["100.64.0.0/10"]
