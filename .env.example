ANTHROPIC_VERTEX_PROJECT_ID=replace-me
CLOUD_ML_REGION=global
CLAUDE_MODEL=claude-sonnet-4-6
USE_FAKE_MODEL=false

# Resiliencia de llamadas al LLM (VertexClaudeAdapter)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_REPAIR_ATTEMPTS=1

# Límites por ejecución (orquestador)
MAX_PLAN_REVISIONS=2
MAX_LLM_CALLS_PER_RUN=8
