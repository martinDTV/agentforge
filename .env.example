# --- Entorno ---
# local | test | staging | production. Fuera de local/test: sslmode=require y /docs deshabilitado.
ENVIRONMENT=local

# --- Autenticación (ADR 0005) ---
# oidc (por defecto) | disabled. "disabled" está prohibido en staging y production.
AUTH_MODE=oidc
OIDC_ISSUER=https://tu-proveedor.example/realms/agentforge
OIDC_AUDIENCE=agentforge
# Exactamente una fuente de claves. En local puedes usar el JWKS de desarrollo:
#   uv run python -m scripts.dev_keys   -> .local/jwks.json (prohibido fuera de local/test)
OIDC_JWKS_URL=https://tu-proveedor.example/realms/agentforge/protocol/openid-connect/certs
# OIDC_JWKS_FILE=.local/jwks.json
# Rutas de reclamaciones (punteadas para anidadas, p. ej. realm_access.roles)
OIDC_ROLES_CLAIM=roles
OIDC_PROJECTS_CLAIM=projects
OIDC_KIND_CLAIM=kind
OIDC_LEEWAY_SECONDS=30
# Separación de funciones: ¿puede el creador de un run aprobarlo? Vacío = prohibido en
# staging/production, permitido en local/test. Fuerza true/false si lo necesitas.
# AUTHZ_SEPARATION_OF_DUTIES=

# --- Claude vía Vertex AI ---
ANTHROPIC_VERTEX_PROJECT_ID=replace-me
CLOUD_ML_REGION=global
CLAUDE_MODEL=claude-sonnet-4-6
USE_FAKE_MODEL=false

# Resiliencia de llamadas al LLM (VertexClaudeAdapter)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_REPAIR_ATTEMPTS=1

# Límites por ejecución (orquestador)
MAX_PLAN_REVISIONS=2
MAX_LLM_CALLS_PER_RUN=8

# --- PostgreSQL ---
# Único driver soportado: psycopg 3. postgresql:// se normaliza a postgresql+psycopg://.
# Nunca commitees una URL con credenciales reales; en despliegue viene del gestor de secretos.
DATABASE_URL=postgresql+psycopg://agentforge:replace-me@127.0.0.1:5432/agentforge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Vacío = derivado del entorno (true en staging/production).
# DATABASE_SSL_REQUIRED=

# --- Checkpoints de LangGraph (AsyncPostgresSaver, misma base, pool propio) ---
CHECKPOINT_POOL_SIZE=5
# Opcional: 16, 24 o 32 bytes => cifrado AES en reposo de los checkpoints. Vacío = sin cifrar.
# Genera una clave fuera del repo (p. ej. openssl rand -hex 16) y guárdala en el gestor de secretos.
# CHECKPOINT_ENCRYPTION_KEY=
# Segundos que el apagado espera a las ejecuciones activas antes de cerrar los pools.
SHUTDOWN_GRACE_SECONDS=30

# --- Leases y recuperación (ADR 0004) ---
RUN_LEASE_TTL_SECONDS=60
# Vacío = un tercio del TTL. Debe ser como mucho la mitad del TTL.
# RUN_HEARTBEAT_SECONDS=
# 0 desactiva el barrido periódico; el barrido de arranque siempre se ejecuta.
RECOVERY_SWEEP_SECONDS=60
RECOVERY_BATCH_SIZE=20
# Reanudar automáticamente runs interrumpidos desde su último checkpoint (cuesta llamadas LLM).
RECOVERY_AUTO_RESUME=false
MAX_RUN_ATTEMPTS=3

# Solo para docker-compose (ignorado por la app)
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=agentforge
POSTGRES_HOST_PORT=5432

# Solo para las pruebas de integración (tests/integration): servidor donde crear bases temporales.
# TEST_DATABASE_ADMIN_URL=postgresql+psycopg://localhost:5432/postgres

# Tool Gateway (Fase 5): límites de las herramientas de solo lectura del workspace.
# TOOL_MAX_READ_BYTES=64000
# TOOL_MAX_ENTRIES=500
# TOOL_MAX_OUTPUT_BYTES=256000
# TOOL_TIMEOUT_SECONDS=10

# Repositorios Git administrados y worktrees por ejecución (Fase 5, Paso 2). Opcional:
# sin GIT_REPOSITORIES_FILE no se registran herramientas Git. Rutas absolutas.
# GIT_REPOSITORIES_ROOT=/srv/agentforge/repos
# GIT_REPOSITORIES_FILE=/srv/agentforge/repositories.json
# WORKTREES_ROOT=/srv/agentforge/worktrees
# Política de desarrollo por repositorio (Fase 7, ADR 0009): sin este archivo la API no ofrece
# el flujo development. JSON: {"repositories": [{"repository_id": ..., "project_id": ..., "writable_globs": [...]}]}
# PROJECTS_FILE=/srv/agentforge/projects.json
# GIT_BINARY=/usr/bin/git
# GIT_TIMEOUT_SECONDS=30
# WORKTREE_RETENTION_SECONDS=3600
# WORKTREE_INTERRUPTED_RETENTION_SECONDS=604800
# WORKTREE_MAX_PER_PROJECT=20
# WORKTREE_MIN_FREE_BYTES=268435456

# Runner de sandbox remoto (Fase 5, Paso 3): VM Linux con Podman rootless alcanzable por Tailscale.
# Sin estas variables, exec.run responde sandbox_unconfigured; nunca se ejecuta código en este host.
# SANDBOX_RUNNER_URL=http://agentforge-runner.tailnet-xxxx.ts.net:8787
# SANDBOX_RUNNER_TOKEN=
# SANDBOX_RUNNER_ID=agentforge-runner-01
# SANDBOX_RUNNER_CA_FILE=
# SANDBOX_RUNNER_ALLOW_PRIVATE_HTTP=false   # http:// a una VM local (192.168.x.x); solo local/test
# SANDBOX_PROFILE=python-3.13
# SANDBOX_CPU_SECONDS=60
# SANDBOX_MEMORY_MB=1024
# SANDBOX_PIDS=256
# SANDBOX_WALL_SECONDS=120
# SANDBOX_STORAGE_MB=512
# SANDBOX_MAX_OUTPUT_BYTES=256000
# SANDBOX_MAX_ARCHIVE_MB=50

# GitHub App (Fase 7, Paso 2; ADR 0010). Platform-only credentials: never
# reach agents, argv, URLs, logs or checkpoints. The key file must be 0600 and
# live outside GIT_REPOSITORIES_ROOT and WORKTREES_ROOT. Leave unset until the
# App exists and is installed only on the sandbox repository (docs/runbooks/github-app.md).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/agentforge-sandbox.private-key.pem
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_SECONDS=15
# MIRROR_FETCH_TIMEOUT_SECONDS=300

# Publication (Fase 7, Paso 3; ADR 0011). Off by default: no write-scoped
# installation token is ever requested and runs end "completed" without
# leaving the host. Turn on only after the App has contents:write and
# pull_requests:write on the sandbox installation (etapa 3.4, with approval).
# GITHUB_WRITE_ENABLED=false
# PUBLISH_ALLOWED_REPOSITORIES=["sandbox-github"]   # required in staging/production
# PUBLISH_PUSH_TIMEOUT_SECONDS=120
# AUTHZ_PUBLISH_DISTINCT_APPROVER=   # default: like AUTHZ_SEPARATION_OF_DUTIES (on in staging/production)

# AgentForge Notifications (correo). Off by default. Gmail: STARTTLS on 587 and an
# *app password* (never the account password). The password lives only in the
# local .env (chmod 0600, ignored by git); it never reaches the outbox, logs,
# audit or checkpoints. AGENTFORGE_EMAIL_TO accepts a comma-separated list.
# AGENTFORGE_EMAIL_ENABLED=false
# AGENTFORGE_SMTP_HOST=smtp.gmail.com
# AGENTFORGE_SMTP_PORT=587
# AGENTFORGE_SMTP_STARTTLS=true
# AGENTFORGE_SMTP_USERNAME=notificacione.agentforge@gmail.com
# AGENTFORGE_SMTP_APP_PASSWORD=
# AGENTFORGE_EMAIL_FROM=notificacione.agentforge@gmail.com
# AGENTFORGE_EMAIL_TO=vazquezmartin1240@gmail.com
# AGENTFORGE_PUBLIC_URL=http://127.0.0.1:8011     # links in the mails (optional)
# NOTIFICATIONS_LEVEL=priority     # priority: aprobaciones, fallos y fin | verbose: todas las etapas
# NOTIFICATIONS_WORKER_INTERVAL_SECONDS=15
# NOTIFICATIONS_MAX_ATTEMPTS=6

# Smart Router: default mode for development runs (auto | fast | full) and the
# classifier confidence needed for the fast route.
# ROUTER_DEFAULT_MODE=auto
# ROUTER_CONFIDENCE_THRESHOLD=0.7
