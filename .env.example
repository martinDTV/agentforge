# --- Entorno ---
# local | test | staging | production. Fuera de local/test: sslmode=require y /docs deshabilitado.
ENVIRONMENT=local

# --- Claude vía Vertex AI ---
ANTHROPIC_VERTEX_PROJECT_ID=replace-me
CLOUD_ML_REGION=global
CLAUDE_MODEL=claude-sonnet-4-6
USE_FAKE_MODEL=false

# Resiliencia de llamadas al LLM (VertexClaudeAdapter)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_REPAIR_ATTEMPTS=1

# Límites por ejecución (orquestador)
MAX_PLAN_REVISIONS=2
MAX_LLM_CALLS_PER_RUN=8

# --- PostgreSQL ---
# Único driver soportado: psycopg 3. postgresql:// se normaliza a postgresql+psycopg://.
# Nunca commitees una URL con credenciales reales; en despliegue viene del gestor de secretos.
DATABASE_URL=postgresql+psycopg://agentforge:replace-me@127.0.0.1:5432/agentforge
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Vacío = derivado del entorno (true en staging/production).
# DATABASE_SSL_REQUIRED=

# --- Checkpoints de LangGraph (AsyncPostgresSaver, misma base, pool propio) ---
CHECKPOINT_POOL_SIZE=5
# Opcional: 16, 24 o 32 bytes => cifrado AES en reposo de los checkpoints. Vacío = sin cifrar.
# Genera una clave fuera del repo (p. ej. openssl rand -hex 16) y guárdala en el gestor de secretos.
# CHECKPOINT_ENCRYPTION_KEY=
# Segundos que el apagado espera a las ejecuciones activas antes de cerrar los pools.
SHUTDOWN_GRACE_SECONDS=30

# --- Leases y recuperación (ADR 0004) ---
RUN_LEASE_TTL_SECONDS=60
# Vacío = un tercio del TTL. Debe ser como mucho la mitad del TTL.
# RUN_HEARTBEAT_SECONDS=
# 0 desactiva el barrido periódico; el barrido de arranque siempre se ejecuta.
RECOVERY_SWEEP_SECONDS=60
RECOVERY_BATCH_SIZE=20
# Reanudar automáticamente runs interrumpidos desde su último checkpoint (cuesta llamadas LLM).
RECOVERY_AUTO_RESUME=false
MAX_RUN_ATTEMPTS=3

# Solo para docker-compose (ignorado por la app)
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=agentforge
POSTGRES_HOST_PORT=5432

# Solo para las pruebas de integración (tests/integration): servidor donde crear bases temporales.
# TEST_DATABASE_ADMIN_URL=postgresql+psycopg://localhost:5432/postgres
