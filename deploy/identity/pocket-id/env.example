# Copiar a .env (chmod 600). Ningún valor real se guarda en Git.
# Referencia: https://pocket-id.org/docs/configuration/environment-variables

# Dirección exacta que abrirá el navegador. Las passkeys quedan ligadas a este dominio.
APP_URL=https://pocket-id.<tailnet>.ts.net

# Clave de cifrado de las claves de firma y datos sensibles: generar con `openssl rand -base64 32`,
# guardarla en ./secrets/encryption_key (0600) y en el gestor de contraseñas del titular.
ENCRYPTION_KEY_FILE=/run/secrets/encryption_key

# El único proxy es tailscale serve en el mismo nodo (loopback).
TRUST_PROXY=127.0.0.1/32,::1/128
ALLOW_INSECURE_CALLBACK_URLS=false

# Sesión del IdP corta: tras 15 min el navegador vuelve a pedir la passkey para iniciar sesión.
# (La reautenticación por decisión la exige el cliente OIDC, no esta variable.)
UI_CONFIG_DISABLED=true
SESSION_DURATION=15
ALLOW_USER_SIGNUPS=disabled
REQUIRE_USER_EMAIL=false
WEBAUTHN_USER_VERIFICATION=required
WEBAUTHN_ALLOW_SYNCED_PASSKEYS=true
WEBAUTHN_AUTHENTICATOR_ATTACHMENT=any
EMAIL_ONE_TIME_ACCESS_AS_UNAUTHENTICATED_ENABLED=false
EMAIL_ONE_TIME_ACCESS_AS_ADMIN_ENABLED=false

# Sin salidas a Internet innecesarias desde el IdP.
ANALYTICS_DISABLED=true
VERSION_CHECK_DISABLED=true
ICON_LIBRARY_URL=disabled
MAXMIND_LICENSE_KEY=

# Registros
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=365

PUID=1000
PGID=1000
